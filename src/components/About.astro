---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { credentials } from "../data/proof";
import { site } from "../data/site";

// Certificate images live in src/assets so they get optimized; a glob keeps the
// data file free of import statements.
const certImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/certificates/*.png",
  { eager: true },
);

const timeline = [
  { period: "2025 — now", role: "Senior Data Scientist, Enterprise Data Office", org: "I&M Group PLC" },
  { period: "2024 — 2025", role: "Assistant Manager, Data Science & Engineering", org: "Equity Group Holdings" },
  { period: "2022 — 2024", role: "Data Scientist, Data Science & Engineering", org: "Equity Group Holdings" },
  { period: "2019 — 2022", role: "Junior Analytics Engineer, Advanced Analytics", org: "Equity Bank Kenya" },
];
---

<section class="section" id="about">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">Who you are working with</p>
      <h2>One person does the work. That person is me.</h2>
    </div>

    <div class="about">
      <div class="about__prose">
        <p class="about__opening">
          I am <strong>Michael Maina</strong> — an actuary by training who moved
          into data science because that is where the decisions were being made.
          Seven years in East African banking, currently
          <strong>{site.role}</strong>.
        </p>
        <p>
          I have spent that time on the unglamorous end of the problem: fraud
          models scored against live payment traffic, credit early-warning
          systems that have to be right before a facility goes bad, cash
          logistics optimization with real money on the line, and dashboards
          used at a branch counter by someone with a customer waiting.
        </p>
        <p>
          When you hire emtatudatatech, you are not handed to a junior team. I
          scope it, I build it, and I am in the room when it goes live. That is
          also why I take on a small number of clients at a time.
        </p>

        <div class="about__actions">
          <a class="btn btn--ghost" href="/cv">
            Read the full CV
            <Icon name="arrowRight" size={16} />
          </a>
          <a
            class="btn btn--ghost"
            href={site.socials.linkedin}
            target="_blank"
            rel="noopener"
          >
            <Icon name="linkedin" size={16} />
            LinkedIn
          </a>
        </div>
      </div>

      <ol class="about__timeline">
        {
          timeline.map((entry) => (
            <li>
              <span class="about__period">{entry.period}</span>
              <strong>{entry.role}</strong>
              <span class="about__org">{entry.org}</span>
            </li>
          ))
        }
        <li class="about__edu">
          <span class="about__period">Education</span>
          <strong>BBS Actuarial Science &amp; Certificate in Data Science</strong>
          <span class="about__org">Strathmore University</span>
        </li>
      </ol>
    </div>

    <div class="certs">
      <h3>Verified certifications</h3>
      <ul class="certs__grid">
        {
          credentials.map((cred) => {
            const img = certImages[`../assets/certificates/${cred.image}`]?.default;
            return (
              <li>
                <a href={cred.url} target="_blank" rel="noopener">
                  {img && (
                    <Image
                      src={img}
                      alt={`${cred.name} certificate issued by ${cred.issuer}`}
                      width={400}
                      widths={[240, 400]}
                      sizes="200px"
                      loading="lazy"
                      decoding="async"
                      format="webp"
                      quality={70}
                    />
                  )}
                  <div class="certs__meta">
                    <strong>{cred.name}</strong>
                    <span>{cred.issuer} · {cred.date}</span>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }

  .about__prose p {
    color: var(--text-2);
    margin-bottom: 1rem;
  }

  .about__opening {
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    color: var(--text) !important;
  }

  .about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }

  .about__timeline {
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .about__timeline li {
    background: var(--surface);
    padding: 1.05rem 1.2rem;
    display: flex;
    flex-direction: column;
  }

  .about__period {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent-ink);
    margin-bottom: 0.35rem;
  }

  .about__timeline strong {
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .about__org {
    font-size: 0.85rem;
    color: var(--text-3);
    margin-top: 0.15rem;
  }

  .about__edu {
    background: var(--surface-2) !important;
  }

  /* --- Certifications --- */

  .certs {
    margin-top: clamp(2.75rem, 5vw, 4rem);
  }

  .certs h3 {
    font-size: 1.15rem;
    margin-bottom: 1.2rem;
  }

  .certs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr));
    gap: 1rem;
  }

  .certs__grid a {
    display: block;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  .certs__grid a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .certs__grid :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    background: #fff;
    padding: 0.6rem;
  }

  .certs__meta {
    padding: 0.85rem 0.95rem;
    border-top: 1px solid var(--border);
  }

  .certs__meta strong {
    display: block;
    font-size: 0.88rem;
    line-height: 1.35;
  }

  .certs__meta span {
    font-size: 0.78rem;
    color: var(--text-3);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
