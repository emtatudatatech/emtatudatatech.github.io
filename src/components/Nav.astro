---
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { primaryCta } from "../data/site";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const links = [
  { href: "/#services", label: "Services" },
  { href: "/#results", label: "Results" },
  { href: "/#packages", label: "Packages" },
  { href: "/#work", label: "Work" },
  { href: "/#about", label: "About" },
  { href: "/cv", label: "CV" },
];
---

<header class:list={["nav", { "is-compact": compact }]} id="nav">
  <div class="wrap nav__inner">
    <a class="nav__logo" href="/" aria-label="emtatudatatech home">
      emtatudatatech<span>.</span>
    </a>

    {
      compact && (
        <a class="nav__back" href="/">
          <Icon name="arrowLeft" size={16} />
          <span>Back to site</span>
        </a>
      )
    }

    {
      !compact && (
        <nav class="nav__links" id="nav-links" aria-label="Primary">
          {links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      )
    }

    <div class="nav__actions">
      <ThemeToggle />
      <a
        class="btn btn--primary nav__cta"
        href={primaryCta.href}
        target="_blank"
        rel="noopener"
      >
        <Icon name="whatsapp" size={17} />
        {compact ? "Get in touch" : "Book a call"}
      </a>
      {
        !compact && (
          <button
            type="button"
            class="nav__burger"
            id="nav-burger"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="nav-links"
          >
            <span class="nav__burger-open"><Icon name="menu" /></span>
            <span class="nav__burger-close"><Icon name="close" /></span>
          </button>
        )
      }
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  /* Browsers without color-mix still get a solid, readable bar. */
  @supports not (background: color-mix(in srgb, red 50%, blue)) {
    .nav {
      background: var(--bg);
    }
  }

  .nav.is-stuck {
    border-bottom-color: var(--border);
  }

  .nav__inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav__logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.06rem;
    letter-spacing: -0.03em;
    flex: none;
    margin-right: auto;
  }

  .nav__logo span {
    color: var(--accent-ink);
  }

  /* In compact mode the back link takes over the spacer role, so the logo must
     give up its auto margin — two auto margins would split the gap between them
     and push the pair apart. */
  .nav.is-compact .nav__logo {
    margin-right: 0.9rem;
  }

  /* Compact-mode return path. Sits beside the logo so it is visible without
     scrolling, on every page that is not the sales page. */
  .nav__back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.95rem 0.45rem 0.75rem;
    margin-right: auto;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-2);
    transition: color 0.16s ease, border-color 0.16s ease, background 0.16s ease;
  }

  .nav__back:hover {
    color: var(--accent-ink);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.65rem;
  }

  .nav__links a {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-2);
    transition: color 0.16s ease;
  }

  .nav__links a:hover {
    color: var(--accent-ink);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: none;
  }

  .nav__cta {
    padding: 0.62rem 1.15rem;
    font-size: 0.88rem;
  }

  .nav__burger {
    display: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
  }

  .nav__burger-close {
    display: none;
  }

  .nav__burger[aria-expanded="true"] .nav__burger-open {
    display: none;
  }

  .nav__burger[aria-expanded="true"] .nav__burger-close {
    display: grid;
  }

  @media (max-width: 940px) {
    .nav__links {
      position: absolute;
      inset: var(--nav-h) 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem clamp(1.15rem, 4vw, 2rem) 1.25rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-lg);

      /* Collapsed by default; opened by toggling the class from script. */
      display: none;
    }

    .nav__links.is-open {
      display: flex;
    }

    .nav__links a {
      padding: 0.85rem 0.25rem;
      font-size: 1rem;
      border-bottom: 1px solid var(--border);
    }

    .nav__links a:last-child {
      border-bottom: none;
    }

    .nav__burger {
      display: grid;
    }
  }

  @media (max-width: 560px) {
    .nav__cta {
      display: none;
    }
  }
</style>

<script>
  const nav = document.getElementById("nav");
  const burger = document.getElementById("nav-burger");
  const links = document.getElementById("nav-links");

  function closeMenu() {
    links?.classList.remove("is-open");
    burger?.setAttribute("aria-expanded", "false");
    burger?.setAttribute("aria-label", "Open menu");
  }

  burger?.addEventListener("click", () => {
    const open = links?.classList.toggle("is-open") ?? false;
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });

  // Any navigation choice dismisses the panel, including anchors on this page.
  links?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) closeMenu();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });

  // Hairline border appears only once the page has scrolled under the bar.
  const sentinel = document.createElement("div");
  sentinel.setAttribute("aria-hidden", "true");
  sentinel.style.cssText = "position:absolute;top:0;height:1px;width:1px;";
  document.body.prepend(sentinel);

  new IntersectionObserver(
    ([entry]) => nav?.classList.toggle("is-stuck", !entry.isIntersecting),
    { threshold: 0 },
  ).observe(sentinel);
</script>
