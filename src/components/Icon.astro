const icon = icons[name];
const common = icon.fill
  ? { fill: "currentColor" }
  : {
      fill: "none",
      stroke: "currentColor",
      "stroke-width": 1.75,
      "stroke-linecap": "round" as const,
      "stroke-linejoin": "round" as const,
    };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  class={className}
  {...common}
>
  {icon.d.map((d) => <path d={d} />)}
</svg>
