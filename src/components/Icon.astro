---
/**
 * Inline SVG icon set. Replaces the RemixIcon and Material Symbols CDN links —
 * two blocking stylesheets and two font downloads become a few hundred bytes of
 * markup that inherits `currentColor` and needs no network at all.
 */
interface Props {
  name: keyof typeof icons;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

/** Stroked icons use currentColor on the stroke; brand marks use fill. */
