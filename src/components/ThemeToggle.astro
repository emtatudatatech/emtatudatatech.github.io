---
import Icon from "./Icon.astro";
---

<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  aria-label="Switch colour theme"
  title="Switch colour theme"
>
  <span class="theme-toggle__icon theme-toggle__icon--sun">
    <Icon name="sun" size={18} />
  </span>
  <span class="theme-toggle__icon theme-toggle__icon--moon">
    <Icon name="moon" size={18} />
  </span>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-2);
    transition: color 0.16s ease, border-color 0.16s ease, background 0.16s ease;
  }

  .theme-toggle:hover {
    color: var(--accent-ink);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  /* Both icons occupy the same grid cell; only one is ever visible. */
  .theme-toggle__icon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    transition: opacity 0.18s ease, transform 0.25s ease;
  }

  .theme-toggle__icon--moon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.6);
  }

  :global(html[data-theme="dark"]) .theme-toggle__icon--sun {
    opacity: 0;
    transform: rotate(45deg) scale(0.6);
  }

  :global(html[data-theme="dark"]) .theme-toggle__icon--moon {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  const toggle = document.getElementById("theme-toggle");
  const root = document.documentElement;

  function sync() {
    const isDark = root.getAttribute("data-theme") === "dark";
    toggle?.setAttribute("aria-pressed", String(isDark));
  }

  toggle?.addEventListener("click", () => {
    const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("theme", next);
    } catch {
      // Private browsing with storage disabled — the theme still switches for
      // this page view, it just will not be remembered.
    }
    sync();
  });

  sync();
</script>
