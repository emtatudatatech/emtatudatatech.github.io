---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { projects, builds } from "../data/projects";
import { site } from "../data/site";

const clientWork = projects.filter((p) => p.kind === "client");
const personalWork = projects.filter((p) => p.kind === "personal");
---

<section class="section section--alt" id="work">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">Case studies</p>
      <h2>What this looks like when it ships.</h2>
      <p class="lede">
        Nine client engagements across banking, insurance, public health and
        education — each one described by what changed, not by the tools used.
      </p>
    </div>

    <div class="work">
      {
        clientWork.map((project, index) => {
          const Wrapper = project.href ? "a" : "div";
          return (
            <Wrapper
              class:list={["work__card", "reveal", { "is-linked": !!project.href }]}
              data-reveal-delay={(index % 3) * 70}
              {...(project.href
                ? { href: project.href, target: "_blank", rel: "noopener" }
                : {})}
            >
              <div class="work__media">
                {/* `width` pins the non-srcset `src` fallback to 800px. Without
                    it Astro emits a full-resolution derivative — several MB per
                    card that no modern browser ever requests. */}
                {project.image && (
                  <Image
                    src={project.image}
                    alt=""
                    width={800}
                    widths={[400, 640, 800]}
                    sizes="(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 360px"
                    loading="lazy"
                    decoding="async"
                    format="webp"
                    quality={62}
                  />
                )}
                <span class="work__result">{project.result}</span>
              </div>

              <div class="work__body">
                <p class="work__meta">
                  <span class="work__category">{project.category}</span>
                  <span class="work__year">{project.year}</span>
                </p>
                <h3>{project.title}</h3>
                <p class="work__client">{project.client}</p>
                <p class="work__desc">{project.description}</p>
                {project.href && (
                  <span class="work__link">
                    View <Icon name="arrowUpRight" size={14} />
                  </span>
                )}
              </div>
            </Wrapper>
          );
        })
      }
    </div>

    <div class="builds">
      <div class="builds__head">
        <h3>Applications I have shipped</h3>
        <a href={site.socials.github} target="_blank" rel="noopener">
          All repositories <Icon name="arrowUpRight" size={14} />
        </a>
      </div>

      <ul class="builds__grid">
        {
          builds.map((build) => (
            <li class="builds__card">
              <h4>{build.name}</h4>
              <p>{build.blurb}</p>
              <ul class="builds__stack">
                {build.stack.map((tool) => (
                  <li>{tool}</li>
                ))}
              </ul>
              <p class="builds__links">
                {build.live && (
                  <a href={build.live} target="_blank" rel="noopener">
                    Live <Icon name="arrowUpRight" size={13} />
                  </a>
                )}
                <a href={build.repo} target="_blank" rel="noopener">
                  Code <Icon name="github" size={13} />
                </a>
              </p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="work__aside">
      <h3>Independent research and writing</h3>
      <ul class="work__aside-list">
        {
          personalWork.map((project) => (
            <li>
              <a href={project.href} target="_blank" rel="noopener">
                <div>
                  <strong>{project.title}</strong>
                  <span>{project.description}</span>
                </div>
                <Icon name="arrowUpRight" size={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .work {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.1rem;
  }

  .work__card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.18s ease, transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .work__card.is-linked:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .work__media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
    overflow: hidden;
  }

  .work__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .work__card.is-linked:hover .work__media :global(img) {
    transform: scale(1.04);
  }

  /* Scrim keeps the result chip readable over any photograph. */
  .work__media::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 60%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
    pointer-events: none;
  }

  .work__result {
    position: absolute;
    left: 0.9rem;
    bottom: 0.85rem;
    z-index: 1;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: -0.02em;
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
    padding-right: 0.9rem;
  }

  .work__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem;
  }

  .work__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin-bottom: 0.7rem;
  }

  .work__category {
    color: var(--accent-ink);
    font-weight: 600;
  }

  .work__year {
    color: var(--text-3);
    margin-left: auto;
  }

  .work__body h3 {
    font-size: 1.1rem;
  }

  .work__client {
    font-size: 0.86rem;
    color: var(--text-3);
    margin-top: 0.3rem;
  }

  .work__desc {
    font-size: 0.9rem;
    color: var(--text-2);
    margin-top: 0.8rem;
  }

  .work__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-ink);
  }

  /* --- Shipped applications --- */

  .builds {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .builds__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1.1rem;
  }

  .builds__head h3 {
    font-size: 1.15rem;
  }

  .builds__head > a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.87rem;
    font-weight: 600;
    color: var(--accent-ink);
  }

  .builds__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
  }

  .builds__card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .builds__card h4 {
    font-family: var(--font-display);
    font-size: 1.02rem;
    margin-bottom: 0.45rem;
  }

  .builds__card > p {
    font-size: 0.89rem;
    color: var(--text-2);
  }

  .builds__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.9rem;
  }

  .builds__stack li {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-3);
    background: var(--surface-2);
  }

  .builds__links {
    display: flex;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  .builds__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-ink);
  }

  .builds__links a:hover {
    text-decoration: underline;
  }

  /* --- Personal work --- */

  .work__aside {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .work__aside h3 {
    font-size: 1.15rem;
    margin-bottom: 1.1rem;
  }

  .work__aside-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .work__aside-list a {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
    padding: 1.15rem 1.25rem;
    background: var(--surface);
    transition: background 0.16s ease;
  }

  .work__aside-list a:hover {
    background: var(--surface-2);
  }

  .work__aside-list strong {
    display: block;
    font-family: var(--font-display);
    font-size: 0.98rem;
    margin-bottom: 0.3rem;
  }

  .work__aside-list span {
    font-size: 0.86rem;
    color: var(--text-3);
  }

  .work__aside-list :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--accent-ink);
  }
</style>
